<section
  id="gift-guide-{{ section.id }}"
  class="gift-guide"
  style="
    --banner-bg: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --button-bg: {{ section.settings.button_color }};
    --button-text: {{ section.settings.button_text_color }};
    --accent-color: {{ section.settings.accent_color }};
  "
>

  <!-- =========================
       TOP BAR
  ========================== -->

  <div class="gift-guide__top">

    <!-- LOGO -->
    <div class="gift-guide__logo">

      {% if section.settings.logo != blank %}

        <img
          src="{{ section.settings.logo | image_url: width: 500 }}"
          alt="{{ shop.name }}"
        >

      {% else %}

        {{ section.settings.logo_text }}

      {% endif %}

    </div>


    <!-- TOP MESSAGE -->
    <div class="gift-guide__top-message">
      {{ section.settings.top_text }}
    </div>


    <!-- TOP BUTTON -->
    <a
      href="{{ section.settings.top_button_link }}"
      class="gift-guide__button gift-guide__button--top"
    >
      <span>
        {{ section.settings.top_button_text }}
      </span>

      <span class="gift-guide__arrow">
        →
      </span>
    </a>

  </div>


  <!-- =========================
       MAIN BANNER
  ========================== -->

  <div class="gift-guide__main">

    <!-- LEFT CONTENT -->
    <div class="gift-guide__left">

      <div class="gift-guide__hero-content">

        <!-- HEADING -->
        <h1 class="gift-guide__title">
          {{ section.settings.heading }}
        </h1>


        <!-- DESCRIPTION -->
        <div class="gift-guide__description">
          {{ section.settings.description }}
        </div>


        <!-- MAIN BUTTON -->
        <a
          href="{{ section.settings.main_button_link }}"
          class="gift-guide__button gift-guide__button--main"
        >

          <span>
            {{ section.settings.main_button_text }}
          </span>

          <span class="gift-guide__arrow">
            →
          </span>

        </a>

      </div>

    </div>


    <!-- RIGHT IMAGE -->
    <div class="gift-guide__right">

      {% if section.settings.background_image != blank %}

        <img
          src="{{ section.settings.background_image | image_url: width: 1800 }}"
          alt=""
          class="gift-guide__image"
          loading="eager"
        >

      {% endif %}

    </div>

  </div>


  <!-- =========================
       BOTTOM TEXT
  ========================== -->

  <div class="gift-guide__bottom">
    {{ section.settings.bottom_text }}
  </div>

</section>


<style>

  /* =====================================================
     MAIN SECTION
  ===================================================== */

  #gift-guide-{{ section.id }} {
    position: relative;
    width: 100%;

    background: var(--banner-bg);
    color: var(--text-color);

    overflow: hidden;

    font-family: Arial, Helvetica, sans-serif;

    border-bottom: 1px solid #eee;
  }


  /* =====================================================
     TOP BAR
  ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__top {

    position: relative;

    width: 100%;

    display: grid;

    grid-template-columns: 1fr auto 1fr;

    align-items: start;

    gap: 20px;

    padding: 5px 30px 0;

    z-index: 5;
  }


  /* =====================================================
     LOGO
  ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__logo {

    justify-self: start;

    display: flex;

    align-items: center;

    min-height: 36px;

    padding: 4px 8px;

    background: #fff;

    border: 1px solid #111;

    color: #111;

    font-size: 19px;

    line-height: 1;

    font-weight: 700;

    letter-spacing: 0.5px;
  }


  #gift-guide-{{ section.id }} .gift-guide__logo img {

    display: block;

    width: auto;

    max-width: 120px;

    max-height: 35px;
  }


  /* =====================================================
     TOP MESSAGE
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__top-message {

    justify-self: center;

    background: #fff;

    border: 1px solid #111;

    padding: 7px 14px;

    font-size: 12px;

    line-height: 1.2;

    text-align: center;

    white-space: nowrap;

    color: #111;
  }


  /* =====================================================
     TOP BUTTON
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__button--top {

    justify-self: end;
  }


  /* =====================================================
     MAIN TWO-COLUMN AREA
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__main {

    position: relative;

    display: grid;

    grid-template-columns: 45% 55%;

    min-height: {{ section.settings.banner_height }}px;

    width: 100%;
  }


  /* =====================================================
     LEFT SIDE
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__left {

    position: relative;

    display: flex;

    align-items: center;

    justify-content: flex-start;

    background: var(--banner-bg);

    padding: 50px 30px 70px 40px;

    z-index: 2;
  }


  #gift-guide-{{ section.id }} .gift-guide__hero-content {

    width: 100%;

    max-width: 430px;
  }


  /* =====================================================
     HEADING
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__title {

    display: inline-block;

    margin: 0 0 24px;

    padding: 4px 7px;

    background: #fff;

    border: 1px solid #111;

    color: #111;

    font-size: clamp(38px, 4.2vw, 58px);

    line-height: 0.95;

    font-weight: 700;

    letter-spacing: -2px;
  }


  /* =====================================================
     DESCRIPTION
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__description {

    display: block;

    width: 100%;

    max-width: 355px;

    margin: 0 0 15px;

    padding: 8px;

    background: #fff;

    border: 1px solid #111;

    color: #111;

    font-size: 13px;

    line-height: 1.4;
  }


  #gift-guide-{{ section.id }} .gift-guide__description p {

    margin: 0;
  }


  /* =====================================================
     RIGHT IMAGE SIDE
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__right {

    position: relative;

    width: 100%;

    height: 100%;

    min-height: {{ section.settings.banner_height }}px;

    background: #fff;

    overflow: hidden;
  }


  #gift-guide-{{ section.id }} .gift-guide__image {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

    object-position: center center;
  }


  /* =====================================================
     BUTTON
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__button {

    position: relative;

    display: inline-flex;

    align-items: center;

    justify-content: space-between;

    gap: 25px;

    min-width: 160px;

    min-height: 38px;

    padding: 9px 16px;

    background: var(--button-bg);

    color: var(--button-text);

    border: 1px solid #111;

    text-decoration: none;

    font-size: 11px;

    line-height: 1;

    font-weight: 500;

    letter-spacing: 0.2px;

    overflow: hidden;

    transition:
      transform 0.25s ease,
      color 0.35s ease;
  }


  /* Animated background */

  #gift-guide-{{ section.id }} .gift-guide__button::before {

    content: "";

    position: absolute;

    left: 0;

    bottom: 0;

    width: 100%;

    height: 0;

    background: #111;

    z-index: 0;

    transition:
      height 0.4s cubic-bezier(.65, 0, .35, 1);
  }


  /* Text */

  #gift-guide-{{ section.id }} .gift-guide__button > span {

    position: relative;

    z-index: 2;
  }


  /* Arrow */

  #gift-guide-{{ section.id }} .gift-guide__arrow {

    display: inline-block;

    font-size: 20px;

    line-height: 1;

    transition:
      transform 0.4s cubic-bezier(.65, 0, .35, 1);
  }


  /* =====================================================
     BUTTON HOVER ANIMATION
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__button:hover {

    color: #fff;

    transform: translateY(-2px);
  }


  #gift-guide-{{ section.id }} .gift-guide__button:hover::before {

    height: 100%;
  }


  #gift-guide-{{ section.id }} .gift-guide__button:hover .gift-guide__arrow {

    transform: translateX(8px);
  }


  /* =====================================================
     MAIN BUTTON
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__button--main {

    background: #111;

    color: #fff;

    min-width: 160px;
  }


  #gift-guide-{{ section.id }} .gift-guide__button--main::before {

    background: var(--accent-color);
  }


  #gift-guide-{{ section.id }} .gift-guide__button--main:hover {

    color: #111;
  }


  /* =====================================================
     BOTTOM TEXT
     ===================================================== */

  #gift-guide-{{ section.id }} .gift-guide__bottom {

    position: absolute;

    bottom: 8px;

    left: 50%;

    transform: translateX(-50%);

    z-index: 10;

    padding: 3px 8px;

    background: #fff;

    border: 1px solid #111;

    color: #111;

    font-size: 10px;

    line-height: 1;

    white-space: nowrap;
  }


  /* =====================================================
     TABLET
     ===================================================== */

  @media screen and (max-width: 900px) {

    #gift-guide-{{ section.id }} .gift-guide__main {

      grid-template-columns: 48% 52%;
    }

    #gift-guide-{{ section.id }} .gift-guide__left {

      padding-left: 25px;

      padding-right: 20px;
    }

    #gift-guide-{{ section.id }} .gift-guide__title {

      font-size: 42px;
    }
  }


  /* =====================================================
     MOBILE
     ===================================================== */

  @media screen and (max-width: 749px) {

    #gift-guide-{{ section.id }} .gift-guide__top {

      grid-template-columns: 1fr 1fr;

      gap: 8px;

      padding: 5px 15px 0;
    }


    #gift-guide-{{ section.id }} .gift-guide__top-message {

      display: none;
    }


    #gift-guide-{{ section.id }} .gift-guide__button--top {

      min-width: auto;
    }


    #gift-guide-{{ section.id }} .gift-guide__main {

      grid-template-columns: 1fr;

      min-height: auto;
    }


    /* Image ABOVE content on mobile */

    #gift-guide-{{ section.id }} .gift-guide__right {

      order: 1;

      height: 350px;

      min-height: 350px;
    }


    #gift-guide-{{ section.id }} .gift-guide__left {

      order: 2;

      min-height: 430px;

      padding: 45px 15px 70px;

      align-items: flex-start;
    }


    #gift-guide-{{ section.id }} .gift-guide__hero-content {

      max-width: 100%;
    }


    #gift-guide-{{ section.id }} .gift-guide__title {

      font-size: 38px;

      letter-spacing: -1.5px;

      margin-bottom: 18px;
    }


    #gift-guide-{{ section.id }} .gift-guide__description {

      max-width: 100%;

      font-size: 12px;
    }


    #gift-guide-{{ section.id }} .gift-guide__bottom {

      max-width: 90%;

      overflow: hidden;

      text-overflow: ellipsis;

      font-size: 8px;
    }
  }

</style>


{% schema %}
{
  "name": "Gift Guide Banner",

  "settings": [

    {
      "type": "header",
      "content": "Banner Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Right side image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Left side background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 580
    },

    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },

    {
      "type": "header",
      "content": "Top Message"
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Top message",
      "default": "Find the ideal gift for your loved ones."
    },

    {
      "type": "header",
      "content": "Top Button"
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Main Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.<br>Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },

    {
      "type": "header",
      "content": "Main Button"
    },
    {
      "type": "text",
      "id": "main_button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "main_button_link",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Bottom Text"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#fff200"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button hover color",
      "default": "#fff200"
    }

  ],

  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}