{{ 'product-hotspot-showcase.css' | asset_url | stylesheet_tag }}
<section
  id="product-hotspot-{{ section.id }}"
  class="phs"

  style="
    --phs-bg: {{ section.settings.background_color }};
    --phs-columns: {{ section.settings.columns }};
    --phs-gap: {{ section.settings.gap }}px;

    --phs-padding-top: {{ section.settings.padding_top }}px;
    --phs-padding-horizontal: {{ section.settings.padding_horizontal }}px;
    --phs-padding-bottom: {{ section.settings.padding_bottom }}px;

    --phs-image-ratio: {{ section.settings.image_ratio }};
    --phs-image-fit: {{ section.settings.image_fit }};

    --phs-hotspot-size: {{ section.settings.hotspot_size }}px;
    --phs-hotspot-bg: {{ section.settings.hotspot_background }};
    --phs-hotspot-color: {{ section.settings.hotspot_color }};

    --phs-popup-width: {{ section.settings.popup_width }}px;
  "
>

  <div class="phs__grid">

    {% for block in section.blocks %}

      {% assign selected_product = block.settings.product %}

      <div
        class="phs__item"
        {{ block.shopify_attributes }}
      >

        {% if block.settings.image != blank %}

          <img
            class="phs__image"
            src="{{ block.settings.image | image_url: width: 1800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >

        {% elsif selected_product != blank and selected_product.featured_image != blank %}

          <img
            class="phs__image"
            src="{{ selected_product.featured_image | image_url: width: 1800 }}"
            alt="{{ selected_product.title | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >

        {% else %}

          <div class="phs__placeholder">
            Add an image
          </div>

        {% endif %}


        {% if selected_product != blank %}

          <button
            type="button"
            class="phs__hotspot"
            style="
              left: {{ block.settings.hotspot_x }}%;
              top: {{ block.settings.hotspot_y }}%;
            "
            data-product-id="{{ selected_product.id }}"
            data-block-id="{{ block.id }}"
            aria-label="View {{ selected_product.title | escape }}"
          >
            <span></span>
            <span></span>
          </button>


          <!-- PRODUCT DATA FOR POPUP -->

          <script type="application/json" id="phs-product-{{ section.id }}-{{ block.id }}">
            {
              "id": {{ selected_product.id | json }},
              "title": {{ selected_product.title | json }},
              "description": {{ selected_product.description | strip_html | json }},
              "url": {{ selected_product.url | json }},
              "featured_image": {% if selected_product.featured_image %}{{ selected_product.featured_image | image_url: width: 700 | json }}{% else %}null{% endif %},
              "price": {{ selected_product.price | money | json }},
              "price_raw": {{ selected_product.price | json }},
              "available": {{ selected_product.available | json }},
              "options": {{ selected_product.options_with_values | json }},
              "variants": [
                {% for variant in selected_product.variants %}
                  {
                    "id": {{ variant.id | json }},
                    "title": {{ variant.title | json }},
                    "available": {{ variant.available | json }},
                    "price": {{ variant.price | money | json }},
                    "price_raw": {{ variant.price | json }},
                    "option1": {{ variant.option1 | json }},
                    "option2": {{ variant.option2 | json }},
                    "option3": {{ variant.option3 | json }},
                    "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 700 | json }}{% else %}null{% endif %}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }
          </script>

        {% endif %}

      </div>

    {% endfor %}

  </div>


  <!-- =========================================
       PRODUCT POPUP
  ========================================== -->

  <div
    class="phs-modal"
    id="phs-modal-{{ section.id }}"
    aria-hidden="true"
  >

    <div class="phs-modal__overlay"></div>

    <div
      class="phs-modal__box"
      role="dialog"
      aria-modal="true"
      aria-label="Product details"
    >

      <button
        type="button"
        class="phs-modal__close"
        aria-label="Close"
      >
        ×
      </button>


      <div class="phs-modal__product">

        <!-- PRODUCT IMAGE -->

        <div class="phs-modal__image-wrap">

          <img
            class="phs-modal__image"
            src=""
            alt=""
          >

        </div>


        <!-- PRODUCT INFO -->

        <div class="phs-modal__info">

          <h2 class="phs-modal__title"></h2>

          <div class="phs-modal__price"></div>

          <div class="phs-modal__description"></div>

          <div class="phs-modal__options"></div>


          <div class="phs-modal__error"></div>


          <button
            type="button"
            class="phs-modal__add"
          >

            <span class="phs-modal__add-text">
              {{ section.settings.add_to_cart_text }}
            </span>

            <span class="phs-modal__add-arrow">
              →
            </span>

          </button>


          <a
            class="phs-modal__view-product"
            href=""
          >
            {{ section.settings.view_product_text }}
          </a>

        </div>

      </div>

    </div>

  </div>

</section>

<script>

  (function () {

    const section = document.querySelector(
      '#product-hotspot-{{ section.id }}'
    );

    if (!section) return;


    const modal = section.querySelector('.phs-modal');

    const modalImage =
      section.querySelector('.phs-modal__image');

    const modalTitle =
      section.querySelector('.phs-modal__title');

    const modalPrice =
      section.querySelector('.phs-modal__price');

    const modalDescription =
      section.querySelector('.phs-modal__description');

    const modalOptions =
      section.querySelector('.phs-modal__options');

    const modalAdd =
      section.querySelector('.phs-modal__add');

    const modalError =
      section.querySelector('.phs-modal__error');

    const viewProduct =
      section.querySelector('.phs-modal__view-product');

    const closeButton =
      section.querySelector('.phs-modal__close');

    const overlay =
      section.querySelector('.phs-modal__overlay');


    let currentProduct = null;

    let selectedOptions = {};

    let currentVariant = null;


    /* =========================================
       FORMAT PRODUCT OPTIONS
    ========================================== */

    function buildOptions(product) {

      modalOptions.innerHTML = '';

      selectedOptions = {};


      if (!product.options || product.options.length === 0) {

        currentVariant =
          product.variants.find(
            variant => variant.available
          ) || product.variants[0];

        return;
      }


      product.options.forEach(function (option, index) {

        const optionName =
          option.name;

        const values =
          option.values || [];


        selectedOptions[index] =
          values[0];


        const wrapper =
          document.createElement('div');

        wrapper.className =
          'phs-option';


        const label =
          document.createElement('label');

        label.className =
          'phs-option__label';

        label.textContent =
          optionName;


        wrapper.appendChild(label);


        /*
         * COLOR / SMALL OPTION LIST
         *
         * Other options use select.
         */

        if (
          values.length <= 5
        ) {

          const valuesWrapper =
            document.createElement('div');

          valuesWrapper.className =
            'phs-option__values';


          values.forEach(function (value, valueIndex) {

            const button =
              document.createElement('button');

            button.type =
              'button';

            button.className =
              'phs-option__value';

            if (valueIndex === 0) {

              button.classList.add(
                'is-selected'
              );

            }

            button.textContent =
              value;


            button.addEventListener(
              'click',
              function () {

                selectedOptions[index] =
                  value;


                valuesWrapper
                  .querySelectorAll(
                    '.phs-option__value'
                  )
                  .forEach(function (item) {

                    item.classList.remove(
                      'is-selected'
                    );

                  });


                button.classList.add(
                  'is-selected'
                );


                updateVariant();

              }
            );


            valuesWrapper.appendChild(
              button
            );

          });


          wrapper.appendChild(
            valuesWrapper
          );

        } else {

          const select =
            document.createElement('select');


          values.forEach(function (value) {

            const optionElement =
              document.createElement('option');

            optionElement.value =
              value;

            optionElement.textContent =
              value;

            select.appendChild(
              optionElement
            );

          });


          select.addEventListener(
            'change',
            function () {

              selectedOptions[index] =
                select.value;

              updateVariant();

            }
          );


          wrapper.appendChild(
            select
          );

        }


        modalOptions.appendChild(
          wrapper
        );

      });


      updateVariant();

    }


    /* =========================================
       FIND MATCHING VARIANT
    ========================================== */

    function updateVariant() {

      if (!currentProduct) return;


      currentVariant =
        currentProduct.variants.find(
          function (variant) {

            return variant.available &&
              Object.keys(selectedOptions)
                .every(function (index) {

                  return (
                    variant[
                      'option' +
                      (parseInt(index) + 1)
                    ] ===
                    selectedOptions[index]
                  );

                });

          }
        );


      /*
       * If exact available variant doesn't exist,
       * find matching unavailable variant.
       */

      if (!currentVariant) {

        currentVariant =
          currentProduct.variants.find(
            function (variant) {

              return Object.keys(selectedOptions)
                .every(function (index) {

                  return (
                    variant[
                      'option' +
                      (parseInt(index) + 1)
                    ] ===
                    selectedOptions[index]
                  );

                });

            }
          );

      }


      if (currentVariant) {

        modalPrice.textContent =
          currentVariant.price;


        if (currentVariant.image) {

          modalImage.src =
            currentVariant.image;

        }


        modalAdd.disabled =
          !currentVariant.available;

        modalAdd.querySelector(
          '.phs-modal__add-text'
        ).textContent =
          currentVariant.available
            ? '{{ section.settings.add_to_cart_text | escape }}'
            : '{{ section.settings.sold_out_text | escape }}';

      }

    }


    /* =========================================
       OPEN PRODUCT
    ========================================== */

    function openProduct(product) {

      currentProduct =
        product;


      modalTitle.textContent =
        product.title;


      modalDescription.textContent =
        product.description || '';


      modalImage.src =
        product.featured_image || '';


      modalImage.alt =
        product.title;


      viewProduct.href =
        product.url;


      modalPrice.textContent =
        product.price;


      modalError.classList.remove(
        'is-visible'
      );

      modalError.textContent =
        '';


      buildOptions(product);


      modal.classList.add(
        'is-open'
      );

      modal.setAttribute(
        'aria-hidden',
        'false'
      );

      document.body.style.overflow =
        'hidden';

    }


    /* =========================================
       CLOSE PRODUCT
    ========================================== */

    function closeModal() {

      modal.classList.remove(
        'is-open'
      );

      modal.setAttribute(
        'aria-hidden',
        'true'
      );

      document.body.style.overflow =
        '';

    }


    /* =========================================
       HOTSPOT CLICK
    ========================================== */

    section
      .querySelectorAll('.phs__hotspot')
      .forEach(function (hotspot) {

        hotspot.addEventListener(
          'click',
          function () {

            const blockId =
              hotspot.dataset.blockId;


            const dataElement =
              document.getElementById(
                'phs-product-{{ section.id }}-' +
                blockId
              );


            if (!dataElement) return;


            try {

              const product =
                JSON.parse(
                  dataElement.textContent
                );


              openProduct(product);

            } catch (error) {

              console.error(
                'Product data error:',
                error
              );

            }

          }
        );

      });


   ```javascript
/* =========================================
   ADD TO CART
========================================= */

modalAdd.addEventListener(
  'click',
  function () {

    if (
      !currentVariant ||
      !currentVariant.available
    ) {

      modalError.textContent =
        '{{ section.settings.select_variant_error | escape }}';

      modalError.classList.add(
        'is-visible'
      );

      return;
    }


    modalAdd.classList.add(
      'is-loading'
    );

    modalError.classList.remove(
      'is-visible'
    );


    fetch(
      window.Shopify.routes.root +
      'cart/add.js',
      {
        method: 'POST',

        headers: {
          'Content-Type':
            'application/json',
          'Accept':
            'application/json'
        },

        body: JSON.stringify({

          items: [
            {
              id: currentVariant.id,
              quantity: 1
            }
          ]

        })

      }
    )

    .then(function (response) {

      if (!response.ok) {

        return response
          .json()
          .then(function (error) {

            throw error;

          });

      }

      return response.json();

    })

    .then(function () {

      /*
       * Remove loading state
       */
      modalAdd.classList.remove(
        'is-loading'
      );


      /*
       * Close product modal
       */
      closeModal();


      /*
       * Get updated cart drawer
       */
      return fetch(
        window.Shopify.routes.root +
        '?section_id=cart-drawer'
      );

    })

    .then(function (response) {

      return response.text();

    })

    .then(function (html) {

      /*
       * Parse returned HTML
       */
      const parser =
        new DOMParser();

      const doc =
        parser.parseFromString(
          html,
          'text/html'
        );


      /*
       * Find current cart drawer
       */
      const currentDrawer =
        document.querySelector(
          'cart-drawer'
        );


      /*
       * Find new cart drawer
       */
      const newDrawer =
        doc.querySelector(
          'cart-drawer'
        );


      /*
       * Replace drawer content
       */
      if (
        currentDrawer &&
        newDrawer
      ) {

        currentDrawer.innerHTML =
          newDrawer.innerHTML;

      }


      /*
       * Open cart drawer
       */
      if (
        currentDrawer &&
        typeof currentDrawer.open ===
        'function'
      ) {

        currentDrawer.open();

      }

      /*
       * Fallback
       */
      else if (currentDrawer) {

        currentDrawer.classList.add(
          'is-open'
        );

        currentDrawer.classList.add(
          'active'
        );

        currentDrawer.removeAttribute(
          'hidden'
        );

      }


      /*
       * Update cart count
       */
      fetch(
        window.Shopify.routes.root +
        'cart.js'
      )

      .then(function (response) {

        return response.json();

      })

      .then(function (cart) {

        document
          .querySelectorAll(
            '[data-cart-count]'
          )
          .forEach(function (element) {

            element.textContent =
              cart.item_count;

          });

      });

    })

    .catch(function (error) {

      console.error(
        'Add to cart error:',
        error
      );


      modalAdd.classList.remove(
        'is-loading'
      );


      modalError.textContent =
        '{{ section.settings.cart_error_text | escape }}';

      modalError.classList.add(
        'is-visible'
      );

    });

  }
);
